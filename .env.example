# Commons settings. Copy to .env.local for local work. On Vercel, the Supabase and Resend
# integrations fill in most of these for you; Commons reads either name where two are listed.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# Postgres. Pooled connection for the app, direct connection for migrations.
# The Supabase integration sets POSTGRES_URL and POSTGRES_URL_NON_POOLING, which also work.
DATABASE_URL=postgresql://postgres:password@localhost:5432/commons
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:5432/commons

# Supabase handles sign-in and private photo storage.
# The integration's NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SECRET_KEY names also work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_SERVICE_ROLE_KEY=sb_secret_example

# The address people use to reach this copy, such as https://trips.example.com.
# On Vercel, the production address is used when this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: share the sign-in session across subdomains of your own domain, such as .example.com.
# Leave empty to keep sign-in cookies on the one address people use (works everywhere).
# COMMONS_AUTH_COOKIE_DOMAIN=

# Protects the daily scheduled job. Any long random string, for example from: openssl rand -base64 32
CRON_SECRET=

# Encrypts invitation links at rest: 32 random bytes, base64 encoded (openssl rand -base64 32).
# Leave empty on a new deploy and Commons creates one and keeps it in your database.
COMMONS_INVITATION_TOKEN_KEY=

# ---------------------------------------------------------------------------------------------
# Email (Resend). Sign-in links, invitations and new-message notices.
# ---------------------------------------------------------------------------------------------

# The Resend integration sets RESEND_API_KEY. The sender must be on a domain you verified in Resend;
# until then Resend only delivers to your own address.
RESEND_API_KEY=
COMMONS_EMAIL_FROM=Commons <trips@example.com>
# live sends through Resend; log prints each email to the server log instead (the default in
# local development); disabled sends nothing.
# COMMONS_EMAIL_SEND_MODE=live

# ---------------------------------------------------------------------------------------------
# Your copy's terms and privacy pages. The built-in pages are templates filled from these.
# ---------------------------------------------------------------------------------------------

# COMMONS_INSTANCE_OWNER_NAME=The Rivera family
# COMMONS_INSTANCE_CONTACT_EMAIL=hello@example.com
# COMMONS_INSTANCE_JURISDICTION=Colorado, United States
# COMMONS_POLICY_EFFECTIVE_DATE=January 1, 2027
# Or link to policies you host yourself:
# COMMONS_TERMS_URL=https://example.com/terms
# COMMONS_PRIVACY_URL=https://example.com/privacy

# ---------------------------------------------------------------------------------------------
# Optional services. Each stays off and hidden until its settings exist.
# ---------------------------------------------------------------------------------------------

# AI writing help for polls. Off without a key. Trip content is sent to OpenAI only when someone
# asks for help writing a poll.
# OPENAI_API_KEY=
# COMMONS_POLL_MODEL=auto

# Product analytics (PostHog). Off without a key. Session replay stays off unless you also set
# NEXT_PUBLIC_POSTHOG_REPLAY=true. Do Not Track and Global Privacy Control are always respected.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_REPLAY=false

# Texting (Twilio). Off without all three values. Messages with Commons works in the app without it;
# texting lets travelers get the same conversation by SMS. Use a verified toll-free number.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# The public address Twilio calls back (defaults to NEXT_PUBLIC_SITE_URL).
# COMMONS_SMS_WEBHOOK_ORIGIN=
# live sends through Twilio; log prints each text to the server log instead.
# COMMONS_SMS_SEND_MODE=live

# ---------------------------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------------------------

# Sign in as made-up people without Supabase, on your own computer. Works only with `npm run dev`,
# on localhost, with the Supabase settings above left empty. Never works in a production build.
# COMMONS_DEV_SIGN_IN=true

# Keep uploaded photos in this folder instead of Supabase Storage while developing.
# COMMONS_LOCAL_MOMENTS_DIR=.local/moments
