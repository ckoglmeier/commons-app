# Server-only pooled Postgres connection used by the Commons web app.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Direct Postgres connection used only for schema migrations.
DATABASE_DIRECT_URL=postgresql://postgres:password@host:5432/postgres

# Supabase participant identity. Use the publishable key (not the service-role key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_SERVICE_ROLE_KEY=sb_secret_example

# Encrypts recoverable invitation-link material at rest. Generate 32 random bytes and base64-encode them.
COMMONS_INVITATION_TOKEN_KEY=

# Protects the durable invitation-delivery retry endpoint.
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://commons.example.com

# Transactional email stays off until a sender domain and test allowlist are configured.
RESEND_API_KEY=re_example
COMMONS_EMAIL_FROM=Commons <trips@updates.example.com>
COMMONS_EMAIL_SEND_MODE=disabled
COMMONS_EMAIL_RECIPIENT_ALLOWLIST=
COMMONS_CONVERSATION_DIGESTS_ENABLED=false
COMMONS_EVENT_ONBOARDING_ENABLED=false
COMMONS_EVENT_ONBOARDING_ALLOWLIST=

# Optional server-only Fieldnotes question assistance. Set both in the deployment
# environment, not NEXT_PUBLIC_* or a committed file. Unset COMMONS_POLL_MODEL keeps help off.
# "auto" selects gpt-6.1-terra (low) for Help me write this and gpt-6-luna (none) for Suggest this change.
# An explicit Responses/structured-output model ID overrides both operations. Activation is a separate approval.
# OPENAI_API_KEY=<configure privately>
# COMMONS_POLL_MODEL=auto

# Organizer-shared workspace rollout; omit the allowlist to retain the legacy UI.
# All active organizers on these trips share the new space; earlier private records stay private.
# Workspace is available to all active trip organizers; no event allowlist is required.
# Coordinator trip changes (stay, budget, dates, destination, plan updates; organizers review and apply) are on for every trip.
# Rollback: set to "false". Unset or any other value leaves them on.
# COMMONS_COORDINATOR_TRIP_CHANGES_ENABLED=false
# COMMONS_WORKSPACE_MODEL=openai/gpt-4.1-mini
# Optional bounded research: only explicitly reviewed public queries are sent.
# Leave unset to disable research. Never expose this as NEXT_PUBLIC_*.
# TAVILY_API_KEY=<configure privately>
# Held for next week’s release; opt-in deeper itinerary research, no chat provider change.
COMMONS_DEEP_RESEARCH_PROVIDER=tavily
# PERPLEXITY_API_KEY=<configure privately>

# Bootstrap operators can approve account-level creation access and recover failed invitation email.
# Keep this list narrow; every operator mutation is written to operator_audit_events.
# Operators also aren't held to hourly AI limits or the research allowance; per-run bounds still apply.
COMMONS_OPERATOR_EMAIL_ALLOWLIST=
# Sign-in emails that see the trip letter and rework map while COMMONS_BETA_REWORK_ENABLED stays off for everyone else.
# COMMONS_BETA_REWORK_ACCOUNTS=

# Feedback and verified beta-access requests notify this inbox. This grants no admin rights.
COMMONS_OPERATOR_NOTIFICATION_EMAIL=organizer@example.com

# Optional local/demo fallback when Supabase Auth is not configured.
COMMONS_PILOT_ACTOR_ID=30000000-0000-4000-8000-000000000001

# Enable only with the /api/internal/research-tasks/ minute scheduler configured.
# Requires TAVILY_API_KEY and CRON_SECRET. Off by default.
COMMONS_DURABLE_RESEARCH_ENABLED=false
# Continuous coordinator: steerable durable tasks, one main conversation per trip, optional subthreads. Off by default.
# Needs migration 0074 applied to the database it uses. Tasks only start when background research is on, the search key is set,
# and an operator sets COMMONS_COORDINATOR_TASK_RUNNER=active to say a runner is really operating (see docs/COORDINATOR-CONTINUITY-REVIEW.md).
COMMONS_COORDINATOR_STEERING_ENABLED=false
COMMONS_COORDINATOR_TASK_RUNNER=none

# Optional organizer setup conversation and trip coordinator styles (migration 0073 required).
COMMONS_COORDINATOR_ONBOARDING_ENABLED=false

# Qualified model for setup and conversations without an editable draft, when onboarding is enabled.
COMMONS_COORDINATOR_ADVISORY_MODEL=openai/gpt-6-astra

# Optional PostHog public project config; only the production domains capture.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Metadata-only coordinator span correlation. Default off; preserves production, DNT/GPC and internal-account exclusions.
# No prompts/completions, no paid eval/replay and no live diagnostic-content permission is granted by this flag.
COMMONS_INFERENCE_TRACING_ENABLED=false
# Reusable traveler invitation links: keep global rollout disabled.
COMMONS_GROUP_INVITATIONS_ENABLED=false
COMMONS_GROUP_INVITATIONS_PILOT_ENABLED=false
# Pilot management uses the existing verified-account AND trip intersection:
# COMMONS_RECIPES_PILOT_EMAILS=organizer@example.com
# COMMONS_RECIPES_PILOT_TRIP_IDS=<synthetic-trip-uuid>

# Organizer-only Compare stays presentation pilot. Default off; uses saved considered stays.
COMMONS_COMPARE_STAYS_ENABLED=false

# Model-composed Coordinator Work using typed JSON and Commons components; organizers only.
COMMONS_COORDINATOR_DYNAMIC_UI_ENABLED=false

# Verified owner only; does not enable research providers or other presentation pilots.
COMMONS_ACTIVITY_DECISIONS_PILOT_ENABLED=false
